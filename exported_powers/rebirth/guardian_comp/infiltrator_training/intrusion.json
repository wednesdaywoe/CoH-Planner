{
  "name": "Intrusion",
  "full_name": "Guardian_Comp.Infiltrator_Training.Intrusion",
  "short_name": "Intrusion",
  "type": "Toggle",
  "display_name": "Intrusion",
  "display_fullname": "Guardian Comp Infiltrator Training Intrusion",
  "display_help": "Your infiltrator training enables you to move quickly without being spotted and recover quickly from injury and exertion. You will only be seen at very close range or if you attack, though even if discovered you will retain a Defense bonus to all attacks, a bonus to your Regeneration, and a reduction in the endurance cost of your powers. Unlike some stealth powers, Intrusion has no movement penalty, and in fact slightly increases your running and jumping speed while active. Intrusion's stealth will not work with any other form of Concealment powers. Recharge: Slow",
  "display_short_help": "Toggle: Self Stealth, +DEF(All), +Regen, +Endurance Discount, +Run Speed, +Jump",
