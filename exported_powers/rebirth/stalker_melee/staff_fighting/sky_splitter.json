{
  "name": "Sky_Splitter",
  "full_name": "Stalker_Melee.Staff_Fighting.Sky_Splitter",
  "short_name": "Sky_Splitter",
  "type": "Click",
  "display_name": "Sky Splitter",
  "display_fullname": "Stalker Melee Staff Fighting Sky Splitter",
  "display_help": "You leap into the air and hammer your foe with an overhead bash from your staff.  Sky Splitter deals Extreme Smashing damage, will knock the target into the air and will briefly disorient your target. This power will build one stack of Perfection of Body if the user has two or less stacks, if the user has three stacks of Perfection of Body it will consume them and gain some benefit.  3 Levels of Perfection of Body will cause additional smashing damage and grant the user a bonus to damage resistance a short time.  Critical Hit damage isn't enhanced by levels of Perfection.  Damage: Extreme, Recharge: Slow",
  "display_short_help": "Melee, Extreme DMG(Smash), Foe Knock Up, Disorient, -Fly, Consumes Perfection",
  "icon": "stafffighting_skysplitter.png",
