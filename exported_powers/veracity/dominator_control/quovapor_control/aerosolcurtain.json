{
  "name": "AerosolCurtain",
  "full_name": "Dominator_Control.QUOVapor_Control.AerosolCurtain",
  "short_name": "AerosolCurtain",
  "type": "Toggle",
  "display_name": "Laughing Gas",
  "display_fullname": "Dominator Control QUOVapor Control AerosolCurtain",
  "display_help": "You create a cloud of Laughing Gas that lingers around the target. If the target is friendly, he or she will become invisible until they attack. Any foes within the radius of Laughing Gas have a chance to be overcome by the fumes and be overcome with nervous laughter, which results in wild dancing. You can attach this power to either an enemy or to an ally. Be warned: when Concussive Mist is combined in very close proximity with Laughing Gas (both centered on the same target), the result is in an unstable mixture that will blow enemies out of the area. Recharge: Long",
  "display_short_help": "Toggle (Ally or Enemy Centered), Invisibility, -Threat (Ally), Terrify (Foe)",
  "icon": "quovaporcontrol_aerosolcurtain.png",
