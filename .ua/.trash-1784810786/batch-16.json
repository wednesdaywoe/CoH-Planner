    {
      "id": "file:src/data/incarnate-procs.ts",
      "type": "file",
      "name": "incarnate-procs.ts",
      "filePath": "src/data/incarnate-procs.ts",
      "summary": "Defines INCARNATE_DAMAGE_PROCS — the Hybrid Assault Radial (PPM) and Interface (fixed-chance) damage procs that fire on every attack — and computes their average per-attack damage contributions using AT modifier tables so the planner's damage breakdown matches in-game and Mids values.",
      "tags": ["data-model", "game-mechanics", "incarnate", "calculation"],
      "complexity": "moderate",
      "languageNotes": "Trigger is a discriminated union ({kind:'ppm'} | {kind:'chance'}); Interface DoTs are modeled as chance × scale × table × ticks averages."
    },
    {
      "id": "file:src/data/proc-data.ts",
      "type": "file",
      "name": "proc-data.ts",
      "filePath": "src/data/proc-data.ts",
      "summary": "The central proc database and math library: PROC_DATABASE entries for every IO-set proc, plus the full PPM chance formula, area-factor geometry, DPS/interpolation math, stacking resolution, and proc-override bookkeeping used across the planner. Merges the residual-effect and variable-control overlay layers onto generated effects.",
      "tags": ["data-model", "game-mechanics", "calculation", "database"],
      "complexity": "complex",
      "languageNotes": "The bulk of the file is the literal PROC_DATABASE (~2,300 lines); calculation helpers follow it, with residual/variable-control overlays merged at module load."
    },
    {
      "id": "file:src/data/proc-residual-effects.ts",
      "type": "file",
      "name": "proc-residual-effects.ts",
      "filePath": "src/data/proc-residual-effects.ts",
      "summary": "Hand-curated PROC_RESIDUAL_EFFECTS overlay: faithful transcriptions of binary mechanics strings for procs the binary generator cannot derive (Rebirth-only sets, Create_Entity pet summons, PBAoE ally buffs, self-meter mechanics), so getProcEffects never falls back to string parsing.",
      "tags": ["data-model", "override-layer", "game-mechanics", "procs"],
      "complexity": "moderate",
      "languageNotes": "Foe-directed effects carry target:'foe' so no dashboard path applies them — they are display-only; this layer REPLACES a proc's whole effects array."
    },
    {
      "id": "file:src/data/proc-variable-controls.ts",
      "type": "file",
      "name": "proc-variable-controls.ts",
      "filePath": "src/data/proc-variable-controls.ts",
      "summary": "Additive PROC_VARIABLE_CONTROLS overlay patching control metadata onto generated proc effects: stack caps (maxStacks), HP-scaling caps (valueMax), and 'By the Slotted Power' AT-table markers (scaleTable) that the binary generator cannot derive.",
      "tags": ["data-model", "override-layer", "configuration", "procs"],
      "complexity": "simple",
      "languageNotes": "Unlike proc-residual-effects (whole-array replacement), this PATCHES fields onto existing effects, keeping binary-sourced values live and regen-safe."
    },
