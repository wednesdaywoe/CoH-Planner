      "name": "atom-query.ts",
      "filePath": "src/data/core/atom-query.ts",
      "summary": "Plan B Phase 1 atom-native read primitives: read-only helpers that let the calc query a power's decoded atom list by effect type, handle the discriminator axes (enhanceable/resistible/duration/toWho) explicitly, and compute per-stat applier values (ToHit, damage, resistance, defense, MaxHP, regen/recovery, movement, KB protection).",
      "tags": ["utility", "calculation", "game-mechanics", "data-access"],
      "complexity": "complex",
      "languageNotes": "Uses a WeakMap keyed on the Power object as a process-lifetime decode cache, and a narrowed Pick<Power,'atoms'> parameter type so callers need not hold a full Power."
    },
