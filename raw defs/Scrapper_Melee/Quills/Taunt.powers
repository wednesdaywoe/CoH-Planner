        {
            Attrib kRange
            Aspect kStr
            Target kTarget
            Table "Melee_Ones"
            Scale -0.7500
            Duration 12.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength
        }
    }

    Effect
    {
        Requires enttype target> player eq @ToHitRoll @ToHit >= @ForceHit || &&
    
