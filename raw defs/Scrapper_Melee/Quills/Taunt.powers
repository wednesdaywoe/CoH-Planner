            {
                DisplayAttackerHit "P2043392969"
                DisplayVictimHit "P2036629572"
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
        Flags HitRollSuccess
    
        AttribMod
        {
            Attrib kTaunt
            Aspect kAbs
            Type kDuration
            Target kTarget
            Table "Melee_Taunt"
            Scale 4.0000
            Magnitude 4.0000
            StackType kReplace
            Messages
            {
                DisplayAttackerHit "P2043392969"
                DisplayVictimHit "P2036629572"
            }
            
        }
    }

    Effect
    {
    
