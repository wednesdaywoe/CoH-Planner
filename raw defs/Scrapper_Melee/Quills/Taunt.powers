    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kTaunt
            Aspect kAbs
            Type kDuration
            Target kTarget
            Table "Melee_Taunt"
            Scale 15.0000
            Magnitude 4.0000
