Power Epic.Psychic_Mastery.Dominate
{
    Name                 "Dominate"                    
    DisplayName          "P1898196680"
    BuyRequires          $archetype @Class_Defender == $archetype @Class_Corruptor == ||
    ModesDisallowed      kDisable_All, kDisable_Epic, kDisable_Pool
    Type                 kClick
    Accuracy             1
    AttackTypes          kPsionic_Attack
    EntsAffected         kFoe
