                DisplayVictimHit "P3642575485"
            }
            
            FX
            {
                ConditionalFX GenericContinuing\StunContinuing.fx
                ConditionalBits ANIM_SonicStun
            }
            
        }
    
        AttribMod
        {
            Attrib kPsionic
            Aspect kAbs
            Target kTarget
