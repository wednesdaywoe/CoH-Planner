    DisplayAttackerHit   "P1461880598"
    IconName             "EnergyAura_Disrupt.tga"
    MaxTargetsHit        5


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_Stun"
            Scale 4.0000
            Magnitude 2.0000
            StackType kRefreshToCount
            StackLimit 1
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_PvPMez"
            Scale 1.0000
            Magnitude 2.0000
            StackType kRefreshToCount
            StackLimit 1
            Suppress Stunned 15 WhenInactive
            Suppress Immobilized 15 WhenInactive
            Suppress Held 15 WhenInactive
            Suppress Sleep 15 WhenInactive
            Suppress Terrorized 15 WhenInactive
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
            }
            
        }
    }

    Effect
    {
    
        AttribMod
        {
            Attrib kEndurance
            Aspect kAbs
            Target kSelf
            Table "Melee_Ones"
            Scale -1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
            Messages
            {
                DisplayVictimHit "P657239359"
            }
            
        }
    }
