Power Stalker_Defense.Energy_Aura.Repulse
{
    Name                 "Repulse"                     
    DisplayName          "P1476019430"
    ModesDisallowed      kDisable_All
    Type                 kToggle
    Accuracy             1
    AttackTypes          kAOE_Attack, kEnergy_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kCaster
    EnduranceCost        0.78
    TimeToActivate       1.67
    TimeToRoot           1.67
    RechargeTime         8
    ActivatePeriod       4
    EffectArea           kSphere
    Radius               12
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kEnduranceDiscount_Boost, kStunned_Boost
    ToggleIgnoreHold     kTrue
    ToggleIgnoreSleep    kTrue
    ToggleIgnoreStun     kTrue
    TargetRequires       Held source.EventTimeSince> 5 > Stunned source.EventTimeSince> 5 > && Sleep source.EventTimeSince> 5 > && kMeter source> .9 < &&
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\StalkerDefense_EnergyAura_Repulse.PFX"
    include              menu\Powers\AnimFX\PlayerPowers\StalkerDefense_EnergyAura_Repulse.PFX
    DisplayShortHelp     "P1212185476"
