            Scale 1.2500
            Duration 5.0000
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    }

    Effect
    {
        Tag "BuildStatic"
        Flags MainTargetOnly
    
