    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Target kTarget
            Table "Ranged_Debuff_Dam"
            Scale 3.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength
            FX
            {
                ContinuingFX PFX
            }
            
        }
    }

    Effect
    {
    
