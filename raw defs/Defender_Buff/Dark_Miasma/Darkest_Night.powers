        {
            Attrib kToHit
            Aspect kCur
            Target kTarget
            Table "Ranged_DeBuff_ToHit"
            Scale 1.5000
            Duration 0.7500
            Magnitude 1.0000
            StackType kReplace
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Target kTarget
