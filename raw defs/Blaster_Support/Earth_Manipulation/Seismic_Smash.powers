Power Blaster_Support.Earth_Manipulation.Seismic_Smash
{
    Name                 "Seismic_Smash"               
    DisplayName          "P1523181219"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1.2
    AttackTypes          kMelee_Attack, kSmashing_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                7
    EnduranceCost        18.512
    TimeToActivate       1.5
    TimeToRoot           1.5
    RechargeTime         20
    EffectArea           kCharacter
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kHold_Boost
    StrengthsDisallowed  kRange
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Blaster_Support_Earth_Manipulation_Seismic_Smash.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Blaster_Support_Earth_Manipulation_Seismic_Smash.pfx
    DisplayShortHelp     "P1326047515"
    DisplayHelp          "VYVPC4BS3G9HYEZ2K9TYSZVTRA"
    IconName             "EarthManip_SeismicSmash"
    DisplayTargetShortHelp "P3220742713"
    DisplayTargetHelp    "P505125029"


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kSmashing
            Aspect kAbs
            Target kTarget
            Table "Melee_Damage"
            Scale 3.5600
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P119576033"
                DisplayVictimHit "P1719855107"
            }
            
        }
    
        AttribMod
        {
            Attrib kHeld
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_Immobilize"
            Scale 8.0000
            Magnitude 3.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P4134654113"
                DisplayVictimHit "P3642575485"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
                ConditionalBits Anim_Stun
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kSmashing
            Aspect kAbs
            Target kTarget
            Table "Melee_PvPDamage"
            Scale 2.2499
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P119576033"
                DisplayVictimHit "P1719855107"
            }
            
        }
    
        AttribMod
        {
            Attrib kHeld
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_PvPMez"
            Scale 1.0000
            Magnitude 3.0000
            StackType kStack
            Suppress Stunned 15 WhenInactive
            Suppress Immobilized 15 WhenInactive
            Suppress Held 15 WhenInactive
            Suppress Sleep 15 WhenInactive
            Suppress Terrorized 15 WhenInactive
            Messages
            {
                DisplayAttackerHit "P4134654113"
                DisplayVictimHit "P3642575485"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
                ConditionalBits Anim_Stun
            }
            
        }
    }

    ActivationEffect
    {
        Tag "Defiance"
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Type kExpression
            Target kCaster
            Table "Ranged_Ones"
            MagnitudeExpr .066 activatetime power.base> * areafactor power.base> /
            DurationExpr activatetime power.base> 7.5 +
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
        }
    }

    ActivationEffect
    {
        Tag "Seismic"
        Requires NearGround source.EventTimeSince> 1 >= Blaster_Ranged.Seismic_Blast source.ownPower? &&
        Flags HideFromInfo
    
        Effect
        {
            Tag "SeismicStress"
        
            AttribMod
            {
                Attrib kExecutePower
                Aspect kCur
                Table "Melee_Ones"
                StackType kStack
                Flags IgnoreCombatMods
                Params Power
                {
                    Power Redirects.Seismic_Blast.Seismic_Stress
                }
                
            }
        }
    }
}
