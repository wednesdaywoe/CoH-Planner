    IconName             "EarthManip_HeavyMallet"


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kSmashing
            Aspect kAbs
            Target kTarget
            Table "Melee_Damage"
            Scale 2.2800
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P119576033"
                DisplayVictimHit "P1719855107"
            }
            
        }
    }

    Effect
    {
        Chance 0.7500
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Melee_Ones"
            Scale 0.6700
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kSmashing
            Aspect kAbs
            Target kTarget
            Table "Melee_PvPDamage"
            Scale 1.8109
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P119576033"
                DisplayVictimHit "P1719855107"
            }
            
        }
    }

    Effect
    {
        Chance 0.7500
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Melee_Ones"
            Scale 0.6700
            Magnitude 1.0000
            StackType kStack
            Suppress Knocked 10 WhenInactive
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }

    ActivationEffect
    {
        Tag "Defiance"
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Type kExpression
            Target kCaster
            Table "Ranged_Ones"
            MagnitudeExpr .066 activatetime power.base> * areafactor power.base> /
            DurationExpr activatetime power.base> 7.5 +
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
        }
    }

    ActivationEffect
    {
        Tag "Seismic"
        Requires NearGround source.EventTimeSince> 1 >= Blaster_Ranged.Seismic_Blast source.ownPower? &&
