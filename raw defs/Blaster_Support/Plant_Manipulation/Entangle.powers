        {
            Attrib kKnockup kKnockback
            Aspect kRes
            Target kTarget
            Table "Ranged_Ones"
            Scale 100.0000
            Duration 15.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance
