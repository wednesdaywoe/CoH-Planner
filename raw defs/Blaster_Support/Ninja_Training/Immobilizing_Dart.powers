Power Blaster_Support.Ninja_Training.Immobilizing_Dart
{
    Name                 "Immobilizing_Dart"           
    DisplayName          "P3214398490"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1.05
    AttackTypes          kRanged_Attack, kLethal_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                60
    EnduranceCost        5.2
    TimeToActivate       1.5
    TimeToRoot           1.5
    RechargeTime         4
    EffectArea           kCharacter
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kRange_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kImmobilized_Boost
    VisualFX             "menu\powers\AnimFX\PlayerPowers\Ninja_Katana_PoisonDart.pfx"
    include              menu\powers\AnimFX\PlayerPowers\Ninja_Katana_PoisonDart.pfx
    DisplayShortHelp     "P1618909432"
    DisplayHelp          "QZW6U5TK6LVFY7VBJCM9P8M653"
    IconName             "NinjaTools_Immob"
    CastThroughHold      kTrue
    CastThroughSleep     kTrue
    CastThroughStun      kTrue
    CastThroughTerrorize kTrue
    DisplayTargetShortHelp "P613114813"
    DisplayTargetHelp    "P2509659565"


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kImmobilized
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_Immobilize"
            Scale 15.0000
            Magnitude 3.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P4257051740"
                DisplayVictimHit "P2588894681"
            }
            
            FX
            {
                ConditionalFX PFX
                ConditionalBits ANIM_LASSOSTUN ANIM_STRONG
            }
            
        }
    
        AttribMod
        {
            Attrib kToxic
            Aspect kAbs
            Target kTarget
            Table "Ranged_Damage"
            Scale 0.2000
            Duration 3.1000
            Magnitude 1.0000
            Delay 0.5000
            Period 1.0000
            StackType kStack
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P4250172858"
                DisplayVictimHit "P1470793739"
            }
            
        }
    }

    Effect
    {
    
        AttribMod
        {
            Attrib kJumpHeight
            Aspect kStr
            Target kTarget
            Table "Ranged_Slow"
            Scale 0.3000
            Duration 18.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength
        }
    
        AttribMod
        {
            Attrib kSpeedRunning kSpeedFlying kSpeedJumping
            Aspect kCur
            Target kTarget
            Table "Ranged_Slow"
            Scale 0.3000
            Duration 18.0000
            Magnitude 1.0000
            StackType kStack
        }
    
        AttribMod
        {
            Attrib kRechargeTime
            Aspect kStr
            Target kTarget
            Table "Ranged_Slow"
            Scale 0.3000
            Duration 18.0000
            Magnitude 1.0000
            StackType kStack
            Flags NearGround IgnoreStrength
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kImmobilized
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_PvPMez"
            Scale 1.0000
            Magnitude 3.0000
            StackType kStack
            Suppress Stunned 15 WhenInactive
            Suppress Immobilized 15 WhenInactive
            Suppress Held 15 WhenInactive
            Suppress Sleep 15 WhenInactive
            Suppress Terrorized 15 WhenInactive
            Messages
            {
                DisplayAttackerHit "P4257051740"
                DisplayVictimHit "P2588894681"
            }
            
            FX
            {
                ConditionalFX PFX
                ConditionalBits ANIM_LASSOSTUN ANIM_STRONG
            }
            
        }
    
        AttribMod
        {
            Attrib kToxic
            Aspect kAbs
            Target kTarget
            Table "Ranged_PvPDamage"
            Scale 0.3220
            Duration 3.1000
            Magnitude 1.0000
            Delay 0.5000
            Period 1.0000
            StackType kStack
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P4250172858"
                DisplayVictimHit "P1470793739"
            }
            
        }
    }

    Effect
    {
        Tag "Defiance"
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Type kExpression
            Target kCaster
            Table "Ranged_Ones"
            MagnitudeExpr .066 activatetime power.base> * areafactor power.base> /
            DurationExpr activatetime power.base> 7.5 +
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
        }
    }
