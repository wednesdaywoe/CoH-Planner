Power Sentinel_Ranged.Storm_Blast.Storm_Cell
{
    Name                 "Storm_Cell"                  
    DisplayName          "Q6NL8GGUT88QWFXPNRSF2JAX2X"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kLocation
    Range                40
    EnduranceCost        5
    TimeToActivate       1.17
    TimeToRoot           1.17
    RechargeTime         15
    EffectArea           kLocation
    Radius               30
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kRange_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kRecovery_Boost, kKnockback_Boost
    TargetNearGround     kTrue
    HighlightEval        kStormCell Mode? !
    HighlightRing        128 128 255 255
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\DefenderRanged_StormBlast_StormCell.PFX"
    include              menu\Powers\AnimFX\PlayerPowers\DefenderRanged_StormBlast_StormCell.PFX
    DisplayShortHelp     "V5BSW9DGG2FDWPXJBWSGRYDGFQ"
    DisplayHelp          "ZXQRR7TZ9M4WWNVXJCH2RPFW9Z"
    IconName             "StormBlast_StormCell.tga"


    Effect
    {
    
        AttribMod
        {
            Attrib kEntCreate
            Aspect kCur
            Target kSelf
            Table "Melee_Level"
            Scale 1.0000
            Duration 60.0000
            Magnitude 1.0000
            StackType kReplace
            Flags CopyBoosts PseudoPet
            Params EntCreate
            {
                DisplayName "Storm Cell"
                PriorityList "PL_StaticObject"
                Power Pets.ResistAll_NoFly.ResistAll
                Power Redirects.Storm_Blast.StormCell_Tempest_Sentinel
                Power Redirects.Storm_Blast.StormCell_SelfDestruct
                Power Redirects.Storm_Blast.Lightning_Proc
            }
            
        }
    
        AttribMod
        {
            Attrib kNull
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 60.0000
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kSetMode
            Aspect kCur
            Type kConstant
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 55.0000
            Magnitude kStormCell
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
        }
    }

    ActivationEffect
    {
        Chance 0.0000
    
        AttribMod
        {
            Attrib kGrantPower
            Aspect kCur
            Target kCastersOwnerAndAllPets
            Table "Melee_Ones"
