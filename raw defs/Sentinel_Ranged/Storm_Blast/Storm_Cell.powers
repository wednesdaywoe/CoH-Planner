            StackType kStack
            Flags NoHitDelay
            Params Power
            {
                Power Redirects.Storm_Blast.StormCell_WindSpeed_Sentinel
            }
            
        }
    
        Effect
        {
            Flags Fallback
        
            AttribMod
            {
                Attrib kGrantPower
                Aspect kCur
                Target kCastersOwnerAndAllPets
                Table "Melee_Ones"
                DelayedRequires Redirects.Storm_Blast.StormCell_Tempest_Sentinel target.ownPower?
                StackType kStack
                Params Power
                {
                    Power Redirects.Storm_Blast.StormCell_LightningAura
                }
                
            }
        }
    }

    ActivationEffect
    {
        Requires kStormCell source.Mode?
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kGrantPower
            Aspect kAbs
            Target kSelf
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Power
