    DisplayTargetShortHelp "P3220742713"
    DisplayTargetHelp    "P3285550051"


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kHeld
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_Immobilize"
            Scale 8.0000
            Magnitude 3.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P4134654113"
                DisplayVictimHit "P3642575485"
            }
            
            FX
            {
                ConditionalFX PFX
                ConditionalBits ANIM_LASSOSTUN ANIM_STRONG
