Power Mastermind_Buff.Poison.Paralytic_Poison
{
    Name                 "Paralytic_Poison"            
    DisplayName          "P2127894003"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1
    AttackTypes          kRanged_Attack, kToxic_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                70
    EnduranceCost        7.8
    TimeToActivate       2
    TimeToRoot           2
    RechargeTime         16
    EffectArea           kCharacter
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kRange_Boost, kEnduranceDiscount_Boost, kHold_Boost
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\MastermindBuff_Poison_ParalyticPoison.PFX"
