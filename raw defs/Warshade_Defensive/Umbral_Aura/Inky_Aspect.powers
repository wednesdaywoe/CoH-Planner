Power Warshade_Defensive.Umbral_Aura.Inky_Aspect
{
    Name                 "Inky_Aspect"                 
    DisplayName          "P3990186459"
    ModesDisallowed      kDisable_All
    ModesSuspended       kWarshade_Blaster_Mode, kWarshade_Tanker_Mode
    Type                 kToggle
    Accuracy             1
    AttackTypes          kAOE_Attack, kNegative_Energy_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kCaster
    EnduranceCost        0.156
    TimeToActivate       1.17
    TimeToRoot           1.17
    RechargeTime         8
    ActivatePeriod       2
    EffectArea           kSphere
    Radius               12
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kEnduranceDiscount_Boost, kStunned_Boost
    ToggleIgnoreHold     kTrue
    ToggleIgnoreSleep    kTrue
    ToggleIgnoreStun     kTrue
    TargetRequires       Held source.EventTimeSince> 5 > Stunned source.EventTimeSince> 5 > && Sleep source.EventTimeSince> 5 > &&
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Warshadow_Oppressive_Gloom.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Warshadow_Oppressive_Gloom.pfx
    DisplayShortHelp     "P4232518503"
    DisplayHelp          "94VBUE7U582RYAMQZ3PE9WNWZ3"
    IconName             "UmbralAura_InkyAspect.tga"
    MaxTargetsHit        10
    DisplayTargetShortHelp "P2848422893"
    DisplayTargetHelp    "P2366756416"


    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_Stun"
            Scale 6.0000
            Magnitude 2.0000
            StackType kRefreshToCount
            StackLimit 1
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing\StunContinuing.fx
            }
            
        }
    }

    Effect
    {
    
        AttribMod
        {
            Attrib kSpecial
            Aspect kAbs
            Target kSelf
            Table "Melee_Damage"
            Scale 0.1000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
            Messages
            {
                DisplayAttackerHit "V8ND2H63B27MYECNYX8SLH9V73"
                DisplayVictimHit "75AP8BX3BDYDY8CUQHXWKZ4ZAA"
            }
            
            FX
            {
                ContinuingFX PFX
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_PvPMez"
            Scale 1.0000
            Magnitude 2.0000
            StackType kRefreshToCount
            StackLimit 1
            Suppress Stunned 15 WhenInactive
            Suppress Immobilized 15 WhenInactive
            Suppress Held 15 WhenInactive
            Suppress Sleep 15 WhenInactive
            Suppress Terrorized 15 WhenInactive
            Flags CancelOnMiss
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing\StunContinuing.fx
            }
            
        }
    }
}
