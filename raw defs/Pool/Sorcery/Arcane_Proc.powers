Power Pool.Sorcery.Arcane_Proc
{
    Name                 "Arcane_Proc"                 
    DisplayName          "P2965369106"
    BuyRequires          Pool.Sorcery.Arcane_Bolt
    ModesDisallowed      kDisable_All, kDisable_Pool, kPeacebringer_Blaster_Mode, kPeacebringer_Tanker_Mode, kWarshade_Blaster_Mode, kWarshade_Tanker_Mode
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    Range                80
    RechargeTime         7
    EffectArea           kCharacter
    IgnoreLevelBought    kTrue
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Pool_Sorcery_arcane_proc.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Pool_Sorcery_arcane_proc.pfx
    DisplayShortHelp     "P2211841663"
    DisplayHelp          "LMXGTZM83XD7WXBQAS2BPF85N3"
    IconName             "SorceryPool_ArcaneBolt.tga"
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    ShowBuffIcon         kFalse
    Free                 kTrue
    AutoIssue            kTrue
    MaxBoosts            0


    Effect
    {
        Requires EndActivateClick target.EventCount> 0 > EndActivateInsp target.EventCount> 0 > + kArcaneBolt source.Mode? ! &&
    
        Effect
        {
            Tag "ArcanePower"
            Chance -0.7500
        
            AttribMod
            {
                Attrib kRechargePower
                Aspect kCur
                Target kSelf
                Table "Ranged_Ones"
                Scale 1.0000
                Magnitude 1.0000
                Delay 1.0000
                StackType kIgnore
                Flags IgnoreStrength IgnoreResistance
                Params Power
                {
                    Power Pool.Sorcery.Arcane_Bolt
                }
                
            }
        
            AttribMod
            {
                Attrib kSetMode
                Aspect kCur
                Type kConstant
                Target kSelf
                Table "Melee_Ones"
                Scale 1.0000
                Duration 15.0000
                Magnitude kArcaneBolt
                Period 15.2500
                StackType kIgnore
                Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
                Messages
                {
                    DisplayAttackerHit "7V3CDX764UABWMVDXE8V96ZR3W"
                }
                
                FX
                {
                    ContinuingFX PFX
                }
                
            }
        }
    
        Effect
        {
            Tag "ArcanePower" "ArcanePowerBoost"
            Flags Fallback
        
            AttribMod
            {
                Attrib kGlobalChanceMod
                Aspect kCur
                Target kSelf
                Table "Melee_Ones"
                Scale 0.1000
                Duration 600.0000
                Magnitude 1.0000
                StackType kStackThenIgnore
                StackLimit 25
                Flags IgnoreStrength IgnoreResistance
                Params EffectFilter
                {
                    Tag ArcanePower
                }
            }
        
            AttribMod
            {
                Attrib kGlobalChanceMod
                Aspect kCur
                Target kSelf
                Table "Melee_Ones"
                Scale -1000.0000
                Duration 1.5000
                Magnitude 1.0000
                StackType kReplace
                Flags IgnoreStrength IgnoreResistance
                Params EffectFilter
                {
                    Tag ArcanePowerBoost
                }
            }
        }
    }
}
