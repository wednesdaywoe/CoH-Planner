    Free                 kTrue
    AutoIssue            kTrue
    MaxBoosts            0


    Effect
    {
        Requires enttype target> critter eq
        Flags SecondaryTargetsOnly
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Melee_Ones"
            Scale 0.6700
            Magnitude 1.0000
            StackType kStack
            Flags NearGround
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }

    Effect
    {
        Requires enttype target> player eq
        Flags SecondaryTargetsOnly
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Melee_Ones"
            Scale 0.6700
            Magnitude 1.0000
            StackType kStack
            Suppress Knocked 10 WhenInactive
            Flags NearGround
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }

    ActivationEffect
    {
    
        AttribMod
        {
            Attrib kSpeedJumping
            Aspect kStr
            Target kSelf
            Table "Melee_SpeedJumping"
            Scale 0.2450
            Duration 30.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelTurboBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSpeedJumping
            Aspect kMax
            Target kSelf
            Table "Melee_Ones"
            Scale 0.6000
            Duration 30.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelTurboMaxBuff
