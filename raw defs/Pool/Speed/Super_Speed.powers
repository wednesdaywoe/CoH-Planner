    EffectArea           kCharacter
    BoostsAllowed        kEnduranceDiscount_Boost, kSpeedRunning_Boost
    ToggleIgnoreHold     kTrue
    ToggleIgnoreSleep    kTrue
    ToggleIgnoreStun     kTrue
    HighlightEval        Redirects.Pool_Speed.Super_Speed_Momentum ownPowerNum? 6 >
    HighlightRing        192 192 192 255
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Pools_Speed_SuperSpeed.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Pools_Speed_SuperSpeed.pfx
    DisplayShortHelp     "P295778697"
    DisplayHelp          "AMENVU83K2Y7W5LL2NGAMSEE5X"
    IconName             "SuperSpeed_SuperSpeed.tga"


    Effect
    {
        Flags PvEOnly
    
        AttribMod
        {
            Attrib kSpeedRunning
            Aspect kCur
            Target kSelf
            Table "Melee_SpeedRunning"
            Scale 1.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSpeedRunning
            Aspect kMax
            Target kSelf
            Table "Melee_Ones"
            Scale 1.9380
            Duration 0.7500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    }

    Effect
    {
    
        AttribMod
        {
            Attrib kSetMode
            Aspect kCur
            Type kConstant
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude kSuperSpeedOn
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kGlobalChanceMod
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params EffectFilter
            {
                Tag TravelStance
            }
        }
    
        AttribMod
        {
            Attrib kSetMode
            Aspect kCur
            Type kConstant
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude kHidden_Attack
            StackType kStack
            StackKey kStealthToggle
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    }

    Effect
    {
        Flags PvPOnly
    
        AttribMod
        {
            Attrib kSpeedRunning
            Aspect kCur
            Target kSelf
            Table "Melee_SpeedRunning"
            Scale 1.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSpeedRunning
            Aspect kMax
            Target kSelf
            Table "Melee_Ones"
            Scale 1.9380
            Duration 0.7500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    }

    Effect
    {
        Tag "MomentumLeap"
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kJumpHeight
            Aspect kCur
            Type kExpression
            Target kSelf
            Table "Melee_Leap"
            Scale 0.1000
            Duration 0.7500
            MagnitudeExpr Redirects.Pool_Speed.Super_Speed_Momentum source.ownPowerNum? @StdResult *
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSpeedJumping
            Aspect kCur
            Type kExpression
            Target kSelf
            Table "Melee_SpeedJumping"
            Scale 0.0750
            Duration 0.7500
            MagnitudeExpr Redirects.Pool_Speed.Super_Speed_Momentum source.ownPowerNum? @StdResult *
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kMovementControl kMovementFriction
            Aspect kCur
            Type kExpression
            Target kSelf
            Table "Melee_Ones"
            Scale -0.1000
            Duration 0.7500
            MagnitudeExpr Redirects.Pool_Speed.Super_Speed_Momentum source.ownPowerNum? @StdResult *
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    }

    Effect
    {
        Tag "MomentumLeap"
        Requires Moved source.EventTimeSince> 1 <= NearGround source.EventTimeSince> 1 >= &&
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kGrantPower
            Aspect kAbs
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance
            Params Power
            {
                Power Redirects.Pool_Speed.Super_Speed_Momentum
            }
            
        }
    }

    Effect
    {
        Requires Attacked source.EventTimeSince> 10 > MissionObjectClick source.EventTimeSince> 10 > &&
    
        AttribMod
        {
            Attrib kStealthRadius
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 35.0000
