Power Pool.Speed.Super_Speed
{
    Name                 "Super_Speed"                 
    DisplayName          "P2257439684"
    ModesDisallowed      kDisable_All, kDisable_Pool, kDisable_RunToggles, kDisable_Travel
    ModesSuspended       kSuppress_PoolToggles, kSuppress_RunToggles, kSuppress_TravelToggles
    Type                 kToggle
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
