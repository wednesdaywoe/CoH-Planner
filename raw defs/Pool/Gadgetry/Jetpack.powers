Power Pool.Gadgetry.Jetpack
{
    Name                 "Jetpack"                     
    DisplayName          "P2682694800"
    BuyRequires          $archtype @Class_Peacebringer == ! $archtype @Class_Warshade == ! && accesslevel char> 0 >= &&
    ModesDisallowed      kDisable_All, kDisable_FlyToggles, kDisable_Pool, kDisable_Travel
    ModesSuspended       kSuppress_FlyToggles, kSuppress_PoolToggles, kSuppress_TravelToggles
    Type                 kToggle
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    EnduranceCost        0.2275
    ActivatePeriod       0.5
    EffectArea           kCharacter
    BoostsAllowed        kEnduranceDiscount_Boost, kSpeedFlying_Boost
    ToggleIgnoreHold     kTrue
    ToggleIgnoreSleep    kTrue
    ToggleIgnoreStun     kTrue
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Pools_Flight_Hover.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Pools_Flight_Hover.pfx
    DisplayShortHelp     "P3312527655"
    DisplayHelp          "P1350787457"
    IconName             "Gadgetry_Jetpack.tga"


    Effect
    {
    
        AttribMod
        {
            Attrib kFly
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kMovementControl
            Aspect kCur
            Target kSelf
            Table "Melee_Control"
            Scale 2.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kMovementFriction
            Aspect kCur
            Target kSelf
            Table "Melee_Friction"
            Scale 2.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSetMode
            Aspect kCur
            Type kConstant
            Target kSelf
            Table "Ranged_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude kJetpackOn
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kGlobalChanceMod
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 0.7500
            Magnitude 1.0000
            StackType kOverlap
            Flags IgnoreStrength IgnoreResistance
            Params EffectFilter
            {
                Tag FlightActive
            }
        }
    
        AttribMod
        {
            Attrib kNull
            Aspect kStr
            Table "Melee_Ones"
            Duration 0.7500
            StackType kStack
            FX
            {
                ContinuingFX PFX
                ConditionalFX PFX
            }
            
        }
    
        Effect
        {
            Tag "Backup"
            Flags HideFromInfo
        
            AttribMod
            {
                Attrib kFly
                Aspect kCur
                Target kSelf
                Table "Melee_Ones"
                Scale 0.1000
                Duration 0.7500
                Magnitude 1.0000
                StackType kReplace
                Flags IgnoreResistance StackByAttribAndKey
            }
        }
    
        Effect
        {
            Tag "HypersonicFly"
            Chance 0.0000
        
            AttribMod
            {
                Attrib kFly
                Aspect kCur
                Target kSelf
                Table "Melee_Ones"
                Scale 2.0000
                Duration 0.7500
                Magnitude 1.0000
                StackType kReplace
                Flags IgnoreResistance
            }
        }
    }

    Effect
    {
        Flags PvEOnly
    
        AttribMod
        {
            Attrib kSpeedFlying
            Aspect kCur
            Target kSelf
            Table "Melee_SpeedFlying"
            Scale 1.1788
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kSpeedFlying
            Aspect kMax
            Target kSelf
            Table "Melee_Ones"
            Scale 2.0475
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelMaxBuff
            Flags IgnoreStrength IgnoreResistance StackByAttribAndKey
        }
    }

    Effect
    {
        Flags PvPOnly
    
        AttribMod
        {
            Attrib kSpeedFlying
            Aspect kCur
            Target kSelf
            Table "Melee_SpeedFlying"
            Scale 1.1788
            Duration 0.7500
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Flags IgnoreResistance StackByAttribAndKey
        }
    }
}
