Power Temporary_Powers.Accolades.Long_Range_Teleport
{
    Name                 "Long_Range_Teleport"         
    DisplayName          "P1822123736"
    ActivateRequires     isTutorialMap? !
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    TimeToActivate       2
    RechargeTime         600
    EffectArea           kCharacter
    StrengthsDisallowed  kRechargeTime
    IgnoreLevelBought    kTrue
    HighlightEval        Temporary_Powers.SilentPowers.Long_Range_Teleport
    HighlightRing        255 0 0 255
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Prestige_Prestige_Travel_Long_Range_Teleport.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Prestige_Prestige_Travel_Long_Range_Teleport.pfx
    DisplayShortHelp     "P107733593"
    DisplayHelp          "NJ8S8Y9XUWZXW5CPF2AL2UZ7KZ"
    IconName             "Accolade_LongRangeTeleport"
    ShowInManage         kFalse

    Redirect
    {
        Power Redirects.Pool_Teleportation.Long_Range_Teleport
        Requires isMissionMap? kDisable_Temp source.Mode? && isPvpMap? || !
    }
    
    Redirect
    {
        Power Redirects.Pool_Teleportation.Long_Range_Teleport_PVP
        Requires isMissionMap? kDisable_Temp source.Mode? && isPvpMap? ||
    }
    
}
