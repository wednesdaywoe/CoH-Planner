            Duration kUntilShutOff
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                VisionPhase AliveContact1
            }
            
        }
    }

    Effect
    {
        Requires type source> hero eq
    
        AttribMod
        {
            Attrib kVisionPhase
