Power Temporary_Powers.Phasing.LabyrinthPhase
{
    Name                 "LabyrinthPhase"              
    DisplayName          "AT4ZZCJ8X3J9YFM7E5KKXSYQCX"
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       99999
    EffectArea           kCharacter
    CastableAfterDeath   kDeadOrAlive
    IgnoreStrength       kTrue
    IgnoreLevelBought    kTrue
    RefreshesOnActivePlayerChange kTrue
    DisplayShortHelp     "P3899172876"
    DisplayHelp          "P3899172876"
    IconName             "Temporary_PVP_DebuffDamage.tga"
    DoNotSave            kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    ShowBuffIcon         kFalse
    Free                 kTrue
    MaxBoosts            0


    Effect
    {
        Requires TrueDark source.inVolume> ! DarkestDark source.inVolume> ! &&
    
        AttribMod
        {
            Attrib kExclusiveVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelfsOwnerAndAllPets
            Table "Melee_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                ExclusiveVisionPhase LabyrinthCore
            }
            
        }
    }

    Effect
    {
        Requires DarkestDark source.inVolume>

        AttribMod
        {
            Attrib kExclusiveVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelfsOwnerAndAllPets
            Table "Melee_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                ExclusiveVisionPhase LabyrinthVoid
            }
            
        }
    }

    Effect
    {
        Requires TrueDark source.inVolume>

        AttribMod
        {
            Attrib kExclusiveVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelfsOwnerAndAllPets
            Table "Melee_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                ExclusiveVisionPhase LabyrinthDark
            }
            
        }
    }
}
