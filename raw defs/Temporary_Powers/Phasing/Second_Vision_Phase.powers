    DoNotSave            kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    ShowBuffIcon         kFalse
    Free                 kTrue
    MaxBoosts            0


    Effect
    {
        Requires mapname> N_City_00_01 eq NTutorialKilledHero source.TokenOwned? &&
    
        AttribMod
        {
            Attrib kVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelf
            Table "Ranged_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                VisionPhase AliveContact3
            }
            
        }
    }

    Effect
    {
        Requires mapname> N_City_00_01 eq NTutorialKilledHero source.TokenOwned? ! &&
    
        AttribMod
        {
