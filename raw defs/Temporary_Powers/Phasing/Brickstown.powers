Power Temporary_Powers.Phasing.Brickstown
{
    Name                 "Brickstown"                  
    DisplayName          "XDWPRKX5XD3PYFZA2WLC9EE9T3"
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       99999
    EffectArea           kCharacter
    CastableAfterDeath   kDeadOrAlive
    IgnoreStrength       kTrue
    IgnoreLevelBought    kTrue
    RefreshesOnActivePlayerChange kTrue
    DisplayShortHelp     "P3899172876"
    DisplayHelp          "P3899172876"
    IconName             "Temporary_PVP_DebuffDamage.tga"
    DoNotSave            kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    ShowBuffIcon         kFalse
    Free                 kTrue
    MaxBoosts            0


    Effect
    {
        Requires Phasing_i24_Hero_Complete_Token source.TokenOwned? Phasing_i24_Hero_Arc_Start_Flashback source.TokenOwned? ! &&
    
        AttribMod
        {
            Attrib kVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelfsOwnerAndAllPets
            Table "Melee_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                VisionPhase AliveContact1
            }
            
        }
    }

    Effect
    {
        Requires Phasing_i27_Stribbling source.TokenOwned? !
    
        AttribMod
        {
            Attrib kVisionPhase
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelfsOwnerAndAllPets
            Table "Melee_Ones"
            Scale 10.0000
            Duration kUntilShutOff
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Phase
            {
                VisionPhase AliveContact2
            }
            
        }
    }
}
