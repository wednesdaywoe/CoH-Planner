Power Temporary_Powers.Temporary_Powers.Offensive_Adaptation_Proc
{
    Name                 "Offensive_Adaptation_Proc"   
    DisplayName          "P2164308101"
    ModesDisallowed      kDisable_All
    Type                 kGlobalBoost
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       2
    EffectArea           kCharacter
    BoostsAllowed        kScience_Boost, kTechnology_Boost, kMagic_Boost, kMutation_Boost, kNatural_Boost, kDamage_Boost
    IgnoreStrength       kTrue
    BoostIgnoreEffectiveness kTrue
    BoostCombinable      kFalse
    DisplayShortHelp     "P2226335223"
    DisplayHelp          "Y94AU5MFM4SHWYBNRZKCFQXHQ2"
    IconName             "Incarnate_Hybrid_Assault_Uncommon.tga"
    CastThroughHold      kTrue
    CastThroughSleep     kTrue
    CastThroughStun      kTrue
    CastThroughTerrorize kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    Free                 kTrue
    MaxBoosts            0
    NumAllowed           1


    Effect
    {
        Tag "Damage"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == && enttype target> critter eq &&
    
        AttribMod
        {
            Attrib kToxic
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Melee_Damage"
            Scale 0.2500
            MagnitudeExpr .8 rechargetime power.base> 0 20 minmax * 1.8 + .2 * @StdResult * areafactor power.base> /
            Magnitude 1.0000
            StackType kStack
            Flags CancelOnMiss IgnoreStrength
            Messages
            {
                DisplayAttackerHit "P2851307520"
                DisplayVictimHit "P105122461"
            }
            
        }
    }

    Effect
    {
        Tag "Damage"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == && enttype target> player eq &&
    
        AttribMod
        {
            Attrib kToxic
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Melee_Damage"
            Scale 0.2500
            MagnitudeExpr activatetime power.base> 0.70 * rechargetime power.base> 0 20 minmax 0.04 * + 0.40 + @StdResult *
            Magnitude 1.0000
            StackType kStack
            Flags CancelOnMiss IgnoreStrength
            Messages
            {
                DisplayAttackerHit "P2851307520"
                DisplayVictimHit "P105122461"
            }
            
        }
    }

    Effect
    {
        Tag "Damage"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == ! &&
    
        AttribMod
        {
            Attrib kToxic
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Melee_Damage"
            Scale 0.2500
            MagnitudeExpr .11 activateperiod power.base> 0 2 minmax * @StdResult * areafactor power.base> /
            Magnitude 1.0000
            StackType kStack
            Flags CancelOnMiss IgnoreStrength
            Messages
            {
                DisplayAttackerHit "P2851307520"
                DisplayVictimHit "P105122461"
            }
            
        }
    }
}
