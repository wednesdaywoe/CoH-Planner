Power Temporary_Powers.Temporary_Powers.Alt_Frost_Bite
{
    Name                 "Alt_Frost_Bite"              
    DisplayName          "P735225228"
    ModesDisallowed      kArena, kDisable_All, kDisable_Temp, kPeacebringer_Blaster_Mode, kPeacebringer_Tanker_Mode, kWarshade_Blaster_Mode, kWarshade_Tanker_Mode
    Type                 kGlobalBoost
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       1
    EffectArea           kCharacter
    BoostsAllowed        kScience_Boost, kTechnology_Boost, kMagic_Boost, kMutation_Boost, kNatural_Boost, kDamage_Boost
    IgnoreStrength       kTrue
    BoostIgnoreEffectiveness kTrue
    BoostCombinable      kFalse
    DisplayShortHelp     "P4225600542"
    DisplayHelp          "P1182404676"
    IconName             "Tem_Frostbite.tga"
    CastThroughHold      kTrue
    CastThroughSleep     kTrue
    CastThroughStun      kTrue
    CastThroughTerrorize kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    Free                 kTrue
    MaxBoosts            0
    NumAllowed           1


    Effect
    {
        Tag "Damage"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == &&
    
        AttribMod
        {
            Attrib kCold
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Melee_Damage"
            Scale 0.1000
            MagnitudeExpr .8 rechargetime power.base> 0 20 minmax * 1.8 + .2 * @StdResult * areafactor power.base> /
            Magnitude 1.0000
            StackType kStack
            Flags CancelOnMiss IgnoreStrength
            Messages
            {
                DisplayAttackerHit "P4173738004"
                DisplayVictimHit "P1163387325"
            }
            
        }
    }

    Effect
    {
        Tag "Damage"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == ! &&
    
        AttribMod
        {
            Attrib kCold
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Melee_Damage"
            Scale 0.1000
            MagnitudeExpr .11 activateperiod power.base> 0 2 minmax * @StdResult * areafactor power.base> /
            Magnitude 1.0000
            StackType kStack
            Flags CancelOnMiss IgnoreStrength
            Messages
            {
                DisplayAttackerHit "P4173738004"
                DisplayVictimHit "P1163387325"
            }
            
        }
    }
}
