    ModesDisallowed      kDisable_All, kDisable_Temp, kPeacebringer_Blaster_Mode, kPeacebringer_Tanker_Mode, kWarshade_Blaster_Mode, kWarshade_Tanker_Mode
    Type                 kClick
    Accuracy             1.4
    AttackTypes          kRanged_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                30
    EnduranceCost        6.5
    TimeToActivate       1.87
    TimeToRoot           1.87
    RechargeTime         4
    EffectArea           kCharacter
    Deletable            kTrue
    VisualFX             "menu\Powers\AnimFX\Temporary_Power_SnakeBeGone_Grenade.pfx"
    include              menu\Powers\AnimFX\Temporary_Power_SnakeBeGone_Grenade.pfx
