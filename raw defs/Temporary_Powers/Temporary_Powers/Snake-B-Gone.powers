    IconName             "Temporary_ChromaticGrenades.tga"


    Effect
    {
        Requires group target> Snakes eq Snakes_Stheno target.VillainName> ! &&
    
        AttribMod
        {
            Attrib kHeld
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_Ones"
            Scale 8.0000
            Magnitude 5.0000
            StackType kReplace
            Messages
            {
                DisplayAttackerHit "P4134654113"
                DisplayVictimHit "P3642575485"
