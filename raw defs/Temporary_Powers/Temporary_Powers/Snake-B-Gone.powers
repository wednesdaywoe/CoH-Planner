                ConditionalFX V_COV\Powers\ItemsandTempPowers\PoisonGun\PoisonHitContinuing.fx
                ConditionalBits ANIM_CHOKESTUN
            }
            
        }
    }

    Effect
    {
        Requires group target> Snakes eq Snakes_Stheno target.VillainName> ! && Objects_Snake_Egg_High_1 target.VillainName> || Objects_Snake_Egg_High_2 target.VillainName> || Objects_Snake_Egg_High_3 target.VillainName> || Objects_Snake_Egg_High_4 target.VillainName> || Objects_Snake_Egg_High_5 target.VillainName> || Objects_Snake_Egg_High_6 target.VillainName> || Objects_Snake_Egg_High_7 target.VillainName> || Objects_Snake_Egg_High_8 target.VillainName> || Objects_Snake_Egg_High_9 target.VillainName> || Objects_Snake_Egg_High_10 target.VillainName> || !
    
        AttribMod
        {
            Attrib kNull
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance
            Messages
            {
                DisplayFloat "P2338895045"
            }
            
        }
    }

    Effect
    {
        Requires Objects_Snake_Egg_High_1 target.VillainName> Objects_Snake_Egg_High_2 target.VillainName> || Objects_Snake_Egg_High_3 target.VillainName> || Objects_Snake_Egg_High_4 target.VillainName> || Objects_Snake_Egg_High_5 target.VillainName> || Objects_Snake_Egg_High_6 target.VillainName> || Objects_Snake_Egg_High_7 target.VillainName> || Objects_Snake_Egg_High_8 target.VillainName> || Objects_Snake_Egg_High_9 target.VillainName> || Objects_Snake_Egg_High_10 target.VillainName> ||
    
        AttribMod
        {
            Attrib kSilentKill
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreResistance
        }
