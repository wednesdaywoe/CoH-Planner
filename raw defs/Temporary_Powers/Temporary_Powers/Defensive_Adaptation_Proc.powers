Power Temporary_Powers.Temporary_Powers.Defensive_Adaptation_Proc
{
    Name                 "Defensive_Adaptation_Proc"   
    DisplayName          "P270837076"
    ModesDisallowed      kDisable_All
    Type                 kGlobalBoost
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       2
    EffectArea           kCharacter
    BoostsAllowed        kScience_Boost, kTechnology_Boost, kMagic_Boost, kMutation_Boost, kNatural_Boost, kDamage_Boost
    IgnoreStrength       kTrue
    BoostIgnoreEffectiveness kTrue
    BoostCombinable      kFalse
    DisplayShortHelp     "P3320071582"
    DisplayHelp          "P176966713"
    IconName             "Incarnate_Hybrid_Assault_Uncommon.tga"
    CastThroughHold      kTrue
    CastThroughSleep     kTrue
    CastThroughStun      kTrue
    CastThroughTerrorize kTrue
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    Free                 kTrue
    MaxBoosts            0
    NumAllowed           1


    Effect
    {
        Tag "HealSelf"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == && enttype source> player eq &&
    
        AttribMod
        {
            Attrib kHeal
            Aspect kAbs
            Type kExpression
            Target kSelf
            Table "Melee_HealSelf"
            Scale 0.0150
            MagnitudeExpr activatetime power.base> @StdResult *
            Magnitude 1.0000
            StackType kReplace
            Flags CancelOnMiss IgnoreStrength IgnoreCombatMods
            Messages
            {
                DisplayVictimHit "P2405956756"
            }
            
        }
    }

    Effect
    {
        Tag "HealSelf"
        Requires target.isFriend? ! PowerSetName power.base> Incarnate.Judgement eq ! && PowerSetName power.base> Incarnate.Ion_Judgement eq ! && activateperiod power.base> 0 == ! && enttype source> player eq &&
    
        AttribMod
        {
            Attrib kHeal
            Aspect kAbs
            Type kExpression
            Target kSelf
            Table "Melee_HealSelf"
            Scale 0.0600
            MagnitudeExpr .11 activateperiod power.base> 0 2 minmax * @StdResult * areafactor power.base> /
            Magnitude 1.0000
            StackType kReplace
            Flags CancelOnMiss IgnoreStrength IgnoreCombatMods
            Messages
            {
                DisplayVictimHit "P2405956756"
            }
            
        }
    }
}
