        {
            Attrib kSilentKill
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreResistance IgnoreCombatMods
            Messages
            {
                DisplayAttackerHit "P3806802528"
            }
            
        }
    
        AttribMod
        {
            Attrib kClearDamagers
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreResistance IgnoreCombatMods
        }
    
        AttribMod
        {
            Attrib kRewardSourceTeam
            Aspect kCur
            Target kSelf
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
