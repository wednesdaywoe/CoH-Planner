        {
            Attrib kConfused
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_PvPMez"
            Scale 1.0000
            Magnitude 2.0000
            StackType kStack
            Suppress Confused 15 WhenInactive
            Messages
            {
                DisplayAttackerHit "P4049735792"
                DisplayVictimHit "P553075930"
            }
            
        }
    }

    Effect
    {
    
        AttribMod
        {
            Attrib kSmashing kLethal kFire kCold kEnergy kNegative_Energy kPsionic kToxic
            Aspect kStr
            Target kTarget
            Table "Melee_Ones"
