    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kConfused
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Melee_Ones"
            Scale 10.0000
            Magnitude 2.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P4049735792"
                DisplayVictimHit "P553075930"
