Power Temporary_Powers.Temporary_Powers.Token_Granter
{
    Name                 "Token_Granter"               
    DisplayName          "P4177098938"
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    TargetVisibility     kNone
    ActivatePeriod       1
    EffectArea           kCharacter
    StackingUsage        kTrue
    DisplayShortHelp     "P2211841663"
    DisplayHelp          "P2211841663"
    IconName             "Teleportation_Wentworths.tga"
    CastThroughSleep     kTrue
    DoNotSave            kTrue
    ShowBuffIcon         kFalse


    Effect
    {
        Requires level source> 2 >= N_Tutorial_LevelUp source.tokenowned? ! &&
    
        AttribMod
        {
            Attrib kRewardSourceTeam
            Aspect kCur
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
            Params Reward
            {
                Reward N_Tutorial_LevelUp
            }
            
        }
    }
}
