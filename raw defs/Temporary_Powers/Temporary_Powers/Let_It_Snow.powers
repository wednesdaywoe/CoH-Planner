Power Temporary_Powers.Temporary_Powers.Let_It_Snow
{
    Name                 "Let_It_Snow"                 
    DisplayName          "P3811999895"
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       5
    EffectArea           kCharacter
    AIReport             kNever
    IsEnvironmentHit     kTrue
    DisplayShortHelp     "GFKXS7UNTAEYY8B8GD26C6K8FS"
    DisplayHelp          "SFZKEXFLV6EZYNZDFCDU3XSHPA"
    IconName             "IceBlast_Blizzard.tga"
    CastThroughHold      kTrue
    CastThroughSleep     kTrue
    CastThroughStun      kTrue
    CastThroughTerrorize kTrue
    DoNotSave            kTrue
    Deletable            kTrue


    Effect
    {
        Requires target.isOutside?
    
        AttribMod
        {
            Attrib kCold
            Aspect kStr
            Target kSelf
            Table "Melee_Ones"
