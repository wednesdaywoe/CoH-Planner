Power Temporary_Powers.Temporary_Powers.Psionic_Activator
{
    Name                 "Psionic_Activator"           
    DisplayName          "P102312025"
    ModesDisallowed      kDisable_All, kDisable_Temp, kPeacebringer_Blaster_Mode, kPeacebringer_Tanker_Mode, kWarshade_Blaster_Mode, kWarshade_Tanker_Mode
    Type                 kClick
    Accuracy             1
    AttackTypes          kRanged_Attack, kPsionic_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                7
    EnduranceCost        6.5
    TimeToActivate       3.17
    TimeToRoot           3.17
    RechargeTime         8
    EffectArea           kCharacter
    NumCharges           20
    StrengthsDisallowed  kRange
    Deletable            kTrue
    VisualFX             "menu\Powers\AnimFX\Temporary_Power_PsionicActivator.pfx"
    include              menu\Powers\AnimFX\Temporary_Power_PsionicActivator.pfx
    DisplayShortHelp     "P1397128752"
    DisplayHelp          "VPAG99MYG8KPWLZ34M7CNY2U42"
    IconName             "Temporary_MeleeModerateDamage.tga"
    DisplayTargetShortHelp "P1397128752"
    DisplayTargetHelp    "P1841613956"


    Effect
    {
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_PvPMez"
            Scale 1.0000
            Magnitude 5.0000
            StackType kStack
            Suppress Stunned 15 WhenInactive
            Suppress Immobilized 15 WhenInactive
            Suppress Held 15 WhenInactive
            Suppress Sleep 15 WhenInactive
            Suppress Terrorized 15 WhenInactive
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
            }
            
        }
    }

    Effect
    {
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kStunned
            Aspect kCur
            Type kDuration
            Target kTarget
            Table "Ranged_Stun"
            Scale 6.0000
            Magnitude 5.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P583235414"
                DisplayVictimHit "P3613904985"
            }
            
            FX
            {
                ConditionalFX GenericContinuing/StunContinuing.fx
            }
            
        }
    }

    Effect
    {
        Requires origin source> Science eq
    
        AttribMod
        {
            Attrib kPsionic
            Aspect kAbs
            Target kTarget
            Table "Ranged_TempDamage"
            Scale 0.5000
            Duration 5.2000
            Magnitude 1.0000
            Period 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P2287672660"
                DisplayVictimHit "P3092393664"
            }
            
        }
    }

    Effect
    {
        Requires Objects_Stasis_Tube_Hero target.VillainName>
    
        AttribMod
        {
            Attrib kEntCreate
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale -1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods CopyBoosts
            Params EntCreate
            {
                EntityDef NPC_Pets_Pet_Rikti_Conscript
                PriorityList "PL_FightPreferMelee"
            }
            
        }
    
        AttribMod
        {
            Attrib kSilentKill
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            Delay 0.2500
            StackType kStack
            Flags IgnoreResistance
        }
    }
}
