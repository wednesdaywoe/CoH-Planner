    IconName             "Inherent_ThrowFrisbee.tga"
    ShowInManage         kFalse
    ShowBuffIcon         kFalse
    NumAllowed           1


    Effect
    {
        Requires Inherent.Inherent.Alt_Frisbee_Granter target.ownPower? !
    
        AttribMod
        {
            Attrib kGrantPower
            Aspect kAbs
            Target kTarget
            Table "Ranged_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kIgnore
            Flags IgnoreStrength IgnoreResistance
            Messages
            {
                DisplayAttackerHit "P107679889"
                DisplayVictimHit "P2291113423"
            }
            
            Params Power
            {
                Power Temporary_Powers.Temporary_Powers.Alt_Granted_Frisbee
            }
            
        }
    }
}
