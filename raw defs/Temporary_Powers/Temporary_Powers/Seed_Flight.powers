Power Temporary_Powers.Temporary_Powers.Seed_Flight
{
    Name                 "Seed_Flight"                 
    DisplayName          "P698031465"
    ModesDisallowed      kDisable_All, kDisable_FlyToggles, kDisable_Travel
    ModesSuspended       kSuppress_FlyToggles, kSuppress_TravelToggles
    Type                 kToggle
    Accuracy             1
    GroupMembership      kFlying_Group
    EntsAffected         kTeammate, kCaster
    EntsAutoHit          kTeammate, kCaster
    Target               kCaster
    ActivatePeriod       3
    EffectArea           kSphere
    Radius               120
    LifeTime             120
    StackingUsage        kTrue
    MaxLifeTime          1800
    IgnoreAttackTimeErrors c-jhamilton
    IgnoreStrength       kTrue
    ToggleIgnoreHold     kTrue
    ToggleIgnoreSleep    kTrue
    ToggleIgnoreStun     kTrue
    StrengthsDisallowed  kEnduranceDiscount
    ServerTrayPriority   1
    Deletable            kTrue
    ShootThroughUntouchable kTrue
    VisualFX             "menu\Powers\AnimFX\Temporary_Power_SeedFlight.pfx"
    include              menu\Powers\AnimFX\Temporary_Power_SeedFlight.pfx
    DisplayShortHelp     "P1772473422"
    DisplayHelp          "JQU2EV6QDS2RWGM98H9H74BKXA"
    IconName             "DayJob_Flight.tga"
    MaxTargetsHit        255
    ShowInManage         kFalse
    DisplayTargetShortHelp "P1772473422"
    DisplayTargetHelp    "P535528821"


    Effect
    {
        Requires Power_DisallowGroupFly target.TokenOwned? !
    
        AttribMod
        {
            Attrib kFly
            Aspect kCur
            Target kTarget
            Table "Melee_Ones"
            Scale 0.7500
            Duration 10.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            Flags IgnoreResistance StackByAttribAndKey
            FX
            {
                ContinuingFX PFX
            }
            
        }
    
        AttribMod
        {
            Attrib kSpeedFlying
            Aspect kCur
            Target kSelf
            Table "Melee_SpeedFlying"
            Scale 1.1000
            Duration 10.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            CancelEvents Stunned Held Sleep
            Suppress ActivateAttackClick 4 Always
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kMovementControl
            Aspect kCur
            Target kTarget
            Table "Melee_Control"
            Scale 10.0000
            Duration 10.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            Flags IgnoreResistance StackByAttribAndKey
        }
    
        AttribMod
        {
            Attrib kMovementFriction
            Aspect kCur
            Target kTarget
            Table "Melee_Friction"
            Scale 10.0000
            Duration 10.0000
            Magnitude 1.0000
            StackType kSuppress
            StackKey kTravelBuff
            Flags IgnoreResistance StackByAttribAndKey
        }
    }
}
