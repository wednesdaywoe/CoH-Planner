Power Temporary_Powers.SilentPowers.Summon_Adamastor_Silent
{
    Name                 "Summon_Adamastor_Silent"     
    DisplayName          "P2342342538"
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       50000
    EffectArea           kCharacter
    LifeTime             2
    CastableAfterDeath   kDeadOrAlive
    IgnoreStrength       kTrue
    IgnoreLevelBought    kTrue
    ShootThroughUntouchable kTrue
    DisplayShortHelp     "P455967244"
    DisplayHelp          "P455967244"
    IconName             "Temporary_SummonAdamastor.tga"
    ShowInManage         kFalse
    ShowInInventory      kFalse
    ShowInInfo           kFalse
    ShowBuffIcon         kFalse
    Free                 kTrue


    Effect
    {
        Requires GM-Adamastor.Eval.AdamastorSummonState ScriptMessage> 0 ==
    
        AttribMod
        {
            Attrib kSetSZEValue
            Aspect kCur
            ApplicationType kOnActivate
            Target kSelf
            Table "Melee_Ones"
            Scale -1.0000
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance IgnoreCombatMods
            Params SZEValue
            {
                ScriptID GM-Adamastor.GetID.dummy ScriptMessage>
                ScriptValue AdamastorSummonState 1
            }
            
        }
    }
}
