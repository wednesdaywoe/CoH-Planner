Power Mastermind_Pets.Medic_3.Frag_Grenade
{
    Name                 "Frag_Grenade"                
    DisplayName          "P3315981163"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1
    AttackTypes          kAOE_Attack, kFire_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                80
    EnduranceCost        14
    DontSetStance        1
    TimeToActivate       1.87
    TimeToRoot           1.87
    RechargeTime         16
    EffectArea           kSphere
    Radius               15
    BoostsAllowed        kAccuracy_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kKnockback_Boost
    StrengthsDisallowed  kRechargeTime
    VisualFX             "menu\Powers\AnimFX\Villain_SubmachineGun_Grenade.pfx"
    include              menu\Powers\AnimFX\Villain_SubmachineGun_Grenade.pfx
    DisplayShortHelp     "P3790063829"
    DisplayHelp          "VFCFYBPDK5TZWVX7GERLFUZR3Z"
    IconName             "AssaultWeapons_ARM30grenade.tga"
    MaxTargetsHit        16
    DisplayTargetShortHelp "P3506567088"


    Effect
    {
    
        Effect
        {
            Requires kFocusFire_Burst target.Mode? kPersonalAttack1 source.Mode? && kFocusFire_Slug target.Mode? kPersonalAttack2 source.Mode? && || kFocusFire_M30 target.Mode? kPersonalAttack3 source.Mode? && ||
            Flags HideFromInfo
        
            AttribMod
            {
                Attrib kFire
                Aspect kAbs
                Type kExpression
                Target kTarget
                Table "Ranged_Damage"
                Scale 0.5000
                MagnitudeExpr @StdResult kFocusFire_Burst target.Mode? kPersonalAttack1 source.Mode? && kFocusFire_Slug target.Mode? kPersonalAttack2 source.Mode? && + kFocusFire_M30 target.Mode? kPersonalAttack3 source.Mode? && + 0.0333 * 1 + *
                Magnitude 1.0000
                StackType kStack
                Messages
                {
                    DisplayAttackerHit "P2798397535"
                    DisplayVictimHit "P459143670"
                }
                
            }
        
            AttribMod
            {
                Attrib kLethal
                Aspect kAbs
                Type kExpression
                Target kTarget
                Table "Ranged_Damage"
                Scale 0.3200
                MagnitudeExpr @StdResult kFocusFire_Burst target.Mode? kPersonalAttack1 source.Mode? && kFocusFire_Slug target.Mode? kPersonalAttack2 source.Mode? && + kFocusFire_M30 target.Mode? kPersonalAttack3 source.Mode? && + 0.0333 * 1 + *
                Magnitude 1.0000
                StackType kStack
                Messages
                {
                    DisplayAttackerHit "P3785438311"
                    DisplayVictimHit "P1873832980"
                }
                
            }
        }
    
        Effect
        {
            Flags Fallback
        
            AttribMod
            {
                Attrib kFire
                Aspect kAbs
                Target kTarget
                Table "Ranged_Damage"
                Scale 0.5000
                Magnitude 1.0000
                StackType kStack
                Messages
                {
                    DisplayAttackerHit "P2798397535"
                    DisplayVictimHit "P459143670"
                }
                
            }
        
            AttribMod
            {
                Attrib kLethal
                Aspect kAbs
                Target kTarget
                Table "Ranged_Damage"
                Scale 0.3200
                Magnitude 1.0000
                StackType kStack
                Messages
                {
                    DisplayAttackerHit "P3785438311"
                    DisplayVictimHit "P1873832980"
                }
                
            }
        }
    }

    Effect
    {
        Chance 0.8000
        Requires enttype target> critter eq
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Ranged_Ones"
            Scale 0.5000
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }

    Effect
    {
        Chance 0.8000
        Requires enttype target> player eq
    
        AttribMod
        {
            Attrib kKnockback
            Aspect kCur
            Target kTarget
            Table "Ranged_Knockback"
            Scale 2.0000
            Magnitude 1.0000
            StackType kStack
            Suppress Knocked 10 WhenInactive
            Messages
            {
                DisplayAttackerHit "P1956156720"
                DisplayVictimHit "P3390955917"
            }
            
        }
    }
}
