Power Mastermind_Pets.Commando.Slug
{
    Name                 "Slug"                        
    DisplayName          "P951006300"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1.05
    AttackTypes          kRanged_Attack, kLethal_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                75
    EnduranceCost        8.528
    PreferenceMultiplier 2
    DontSetStance        1
    TimeToActivate       1.87
    TimeToRoot           1.87
    RechargeTime         8
    EffectArea           kCharacter
    BoostsAllowed        kAccuracy_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kKnockback_Boost
    StrengthsDisallowed  kRechargeTime
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Mastermind_Pets_Commando_Slug.pfx"
