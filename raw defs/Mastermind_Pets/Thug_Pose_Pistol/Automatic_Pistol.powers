Power Mastermind_Pets.Thug_Pose_Pistol.Automatic_Pistol
{
    Name                 "Automatic_Pistol"            
    DisplayName          "P781540293"
    Type                 kClick
    Accuracy             1.2
    AttackTypes          kRanged_Attack, kLethal_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                60
    EnduranceCost        3.952
    TimeToActivate       2.33
    TimeToRoot           2.33
    RechargeTime         3.5
    EffectArea           kCharacter
    BoostsAllowed        kAccuracy_Boost, kDamage_Boost
    StrengthsDisallowed  kRechargeTime
    VisualFX             "menu\Powers\AnimFX\Villain_AutomaticPistol.pfx"
    include              menu\Powers\AnimFX\Villain_AutomaticPistol.pfx
    DisplayShortHelp     "P1152063585"
    DisplayHelp          "NVNPRDZNBCKEY8X8Q24N99RYZS"
    IconName             "AssaultWeapons_ARBurst.tga"


    Effect
    {
    
        AttribMod
        {
            Attrib kLethal
            Aspect kAbs
            Target kTarget
            Table "Ranged_Damage"
            Scale 1.1000
            Magnitude 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P3785438311"
                DisplayVictimHit "P1873832980"
            }
            
        }
    }

    Effect
    {
        Requires Raid target.HasTag? ! enttype target> critter eq &&
    
        AttribMod
        {
            Attrib kTaunt
            Aspect kAbs
            Type kDuration
            Target kTarget
            Table "Ranged_Ones"
            Scale 4.0000
            Magnitude 4.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P2043392969"
                DisplayVictimHit "P2036629572"
            }
            
        }
    }
}
