                }
                
            }
        }
    
        Effect
        {
            Flags Fallback
        
            AttribMod
            {
                Attrib kLethal
                Aspect kAbs
                Target kTarget
                Table "Ranged_Damage"
                Scale 0.9100
                Magnitude 1.0000
                StackType kStack
                Messages
                {
                    DisplayAttackerHit "P3785438311"
                    DisplayVictimHit "P1873832980"
                }
                
            }
        }
    }

