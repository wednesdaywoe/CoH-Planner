Power Mastermind_Pets.Commando_3.Flamethrower
{
    Name                 "Flamethrower"                
    DisplayName          "P514829104"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1.1
    AttackTypes          kAOE_Attack, kFire_Attack
    EntsAffected         kFoe
    EntsAutoHit          kNone
    Target               kFoe
    Range                40
    EnduranceCost        15.6
    PreferenceMultiplier 3
    DontSetStance        1
    TimeToActivate       2.3
    TimeToRoot           2.3
    RechargeTime         20
    EffectArea           kCone
    Radius               40
    Arc                  45
    BoostsAllowed        kAccuracy_Boost, kEnduranceDiscount_Boost, kDamage_Boost
    StrengthsDisallowed  kRechargeTime
    VisualFX             "menu\Powers\AnimFX\PlayerPowers\Mastermind_Pets_Commando_3_Flamethrower.pfx"
    include              menu\Powers\AnimFX\PlayerPowers\Mastermind_Pets_Commando_3_Flamethrower.pfx
    DisplayShortHelp     "SY8HLZWGQ9HLW4XB7Y3LDYBKJZ"
    DisplayHelp          "VLZNHMGJYD96YEXW7LPGPV7J8W"
    IconName             "AssaultWeapons_ARFlamethrower.tga"
    MaxTargetsHit        10
    DisplayTargetShortHelp "P3423146141"
    DisplayTargetHelp    "P106624625"


    Effect
    {
        Requires kFocusFire_Burst target.Mode? kPersonalAttack1 source.Mode? && kFocusFire_Slug target.Mode? kPersonalAttack2 source.Mode? && || kFocusFire_M30 target.Mode? kPersonalAttack3 source.Mode? && ||
        Flags HideFromInfo
    
        AttribMod
        {
            Attrib kFire
            Aspect kAbs
            Type kExpression
            Target kTarget
            Table "Ranged_Damage"
            Scale 0.2420
            Duration 7.1000
            MagnitudeExpr @StdResult kFocusFire_Burst target.Mode? kPersonalAttack1 source.Mode? && kFocusFire_Slug target.Mode? kPersonalAttack2 source.Mode? && + kFocusFire_M30 target.Mode? kPersonalAttack3 source.Mode? && + 0.0333 * 1 + *
            Magnitude 1.0000
            Delay 1.0000
            Period 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P1083355571"
                DisplayVictimHit "P3022741469"
            }
            
            FX
            {
                ContinuingFX POWERS/FireControl/CindersHit.fx
            }
            
        }
    }

    Effect
    {
        Flags Fallback
    
        AttribMod
        {
            Attrib kFire
            Aspect kAbs
            Target kTarget
            Table "Ranged_Damage"
            Scale 0.2420
            Duration 7.1000
            Magnitude 1.0000
            Delay 1.0000
            Period 1.0000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P1083355571"
                DisplayVictimHit "P3022741469"
            }
            
            FX
            {
                ContinuingFX POWERS/FireControl/CindersHit.fx
            }
            
        }
    }
}
