Power Mastermind_Pets.Lioness_3.PM_Ferocious_Growl
{
    Name                 "PM_Ferocious_Growl"          
    DisplayName          "P3111718594"
    ModesDisallowed      kDisable_All
    Type                 kClick
    Accuracy             1
    EntsAffected         kMyOwner
    EntsAutoHit          kMyOwner
    Target               kCaster
    PreferenceMultiplier -1
    EffectArea           kSphere
    Radius               30
    DisplayShortHelp     "P1771697811"
    DisplayHelp          "P2692741157"
    IconName             "BeastMastery_PetFerociousGrowl.tga"
    MaxTargetsHit        1
    ShowBuffIcon         kFalse


    Effect
    {
        Requires temporary_powers.temporary_powers.Pack_Mentality_Lock target.ownPower? !
    
        AttribMod
        {
            Attrib kGrantPower
            Aspect kAbs
            Target kTarget
            Table "Melee_Ones"
            Scale 1.0000
            Magnitude 1.0000
            StackType kStack
            Flags IgnoreStrength IgnoreResistance
            Params Power
            {
                Power Temporary_Powers.Temporary_Powers.Pack_Mentality
            }
            
        }
    }
}
