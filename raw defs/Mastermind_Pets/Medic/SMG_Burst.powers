            Magnitude 1.0000
            Period 0.3000
            StackType kStack
            Messages
            {
                DisplayAttackerHit "P3137354887"
                DisplayVictimHit "P130826600"
            }
            
        }
    
        AttribMod
        {
            Attrib kDefense
            Aspect kCur
            Target kTarget
            Table "Ranged_Debuff_Def"
            Scale 1.0000
            Duration 5.0000
            Magnitude 1.0000
            StackType kStack
        }
    }

    Effect
    {
