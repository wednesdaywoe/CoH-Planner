Power Sentinel_Defense.Radiation_Armor.Gamma_Boost
{
    Name                 "Gamma_Boost"                 
    DisplayName          "P939113537"
    ModesDisallowed      kDisable_All
    Type                 kAuto
    Accuracy             1
    EntsAffected         kCaster
    EntsAutoHit          kCaster
    Target               kCaster
    ActivatePeriod       1
    EffectArea           kCharacter
    BoostsAllowed        kHeal_Boost, kRecovery_Boost
    DisplayShortHelp     "P976686663"
    DisplayHelp          "P1415480280"
    IconName             "RadiationArmor_GammaBoost.tga"


    Effect
    {
    
        AttribMod
        {
            Attrib kRegeneration
            Aspect kCur
            Type kExpression
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 1.2500
            MagnitudeExpr 75 kHitPoints% source> - 30 + 100 / @StdResult *
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kRegeneration
            Aspect kRes
            Target kSelf
            Table "Melee_Res_Boolean"
            Scale 0.5000
            Duration 1.2500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kRecovery
            Aspect kCur
            Type kExpression
            Target kSelf
            Table "Melee_Ones"
            Scale 1.0000
            Duration 1.2500
            MagnitudeExpr 1.2 kHitPoints% source> * 100 / .3 * @StdResult *
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreResistance
        }
    
        AttribMod
        {
            Attrib kEndurance kRecovery
            Aspect kRes
            Target kTarget
            Table "Melee_Res_Boolean"
            Scale 2.0000
            Duration 1.2500
            Magnitude 1.0000
            StackType kReplace
            Flags IgnoreStrength IgnoreResistance
        }
    }
