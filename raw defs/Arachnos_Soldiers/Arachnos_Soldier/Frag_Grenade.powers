    EntsAutoHit          kNone
    Target               kFoe
    Range                80
    EnduranceCost        15.184
    TimeToActivate       1.67
    TimeToRoot           1.67
    RechargeTime         16
    EffectArea           kSphere
    Radius               10
    BoostsAllowed        kAccuracy_Boost, kRecharge_Boost, kRange_Boost, kEnduranceDiscount_Boost, kDamage_Boost, kKnockback_Boost
    VisualFX             "menu\Powers\AnimFX\ArachnosSoldier_FragGrenade_Switchboard.pfx"
